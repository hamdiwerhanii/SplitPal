NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/splitpal
CORS_ORIGINS=http://localhost:8081

JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

OTP_SECRET=change-me-to-another-long-random-string-32-chars
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SplitPal <no-reply@splitpal.local>

INVITE_URL_BASE=splitpal://join

PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
